# Nox::UI Theme (.nstyle) - Live hot-reloaded by NOXWatcher
tokens:
  Background: "#15161A"
  Surface0: "#1D1F24FA"
  Surface1: "#25272EFA"
  Surface2: "#2F313AFA"
  Border: "#3C404CD9"
  Accent: "#4287F5"
  AccentHover: "#5997F9"
  Success: "#3CAD7B"
  Warning: "#D99D39"
  Danger: "#D54F55"
  Text: "#EAEDF3"
  TextMuted: "#949DAF"

styles:
  Background:
    fill: "$Background"
    border_thickness: 0
    shadow_blur: 0
    corner_radius: 0
    padding: 0

  Label:
    text_color: "$Text"
    font_size: 18

  Panel:
    fill: "$Surface0"
    border_color: "$Border"
    border_thickness: 1.0
    shadow_color: "#00000052"
    shadow_offset: [0, 4]
    shadow_blur: 10
    corner_radius: 8
    padding: 12
    text_color: "$Text"
    font_size: 18

  TopBar:
    fill: "$Surface0"
    border_color: "$Border"
    border_thickness: 1.0
    shadow_color: "#00000040"
    shadow_offset: [0, 2]
    shadow_blur: 6
    corner_radius: 6
    padding: [12, 6]

  Button:
    fill: "$Surface1"
    border_color: "$Border"
    border_thickness: 1.0
    corner_radius: 6
    padding: [12, 6]
    text_color: "$Text"
    font_size: 18
    transition_ms: 80

  "Button:hover":
    fill: "$Surface2"
    border_color: "$Accent"
    text_color: "#FFFFFF"

  "Button:pressed":
    fill: "#3264B5"
    border_color: "$AccentHover"

  "Button.primary":
    fill: "$Accent"
    border_color: "$AccentHover"
    text_color: "#FFFFFF"

  "Button.primary:hover":
    fill: "$AccentHover"
    border_color: "#FFFFFF55"

  "Button.primary:pressed":
    fill: "#2F66BD"

  CheckBox:
    fill: "#141720"
    border_color: "$Border"
    border_thickness: 1.2
    corner_radius: 4
    text_color: "$Text"
    font_size: 18

  "CheckBox:hover":
    border_color: "$Accent"

  Slider:
    fill: "#141720"
    border_color: "$Border"
    text_color: "$TextMuted"
    font_size: 18

  DragScalar:
    fill: "#141720"
    border_color: "$Border"
    border_thickness: 1.0
    corner_radius: 5
    padding: [6, 4]
    text_color: "$Text"
    font_size: 18

  "DragScalar:hover":
    border_color: "$Accent"

  "DragScalar:focus":
    border_color: "$AccentHover"

  TextInput:
    fill: "#141720"
    border_color: "$Border"
    border_thickness: 1.0
    corner_radius: 5
    padding: [8, 5]
    text_color: "$Text"
    font_size: 18

  "TextInput:hover":
    border_color: "#526080"

  "TextInput:focus":
    fill: "#161B26"
    border_color: "$Accent"

  TreeView:
    fill: "#13161E"
    border_color: "$Border"
    border_thickness: 1.0
    corner_radius: 6
    text_color: "$Text"
    font_size: 18

  SectionHeader:
    fill: "#1E222E"
    fill_bottom: "#191C26"
    border_color: "$Border"
    border_thickness: 1.0
    corner_radius: 5
    padding: [10, 4]
    text_color: "$Text"
    font_size: 18

  "SectionHeader:hover":
    fill: "#262C3B"
    border_color: "$Accent"

  TabBar:
    fill: "$Surface1"
    border_color: "$Border"
    border_thickness: 1.0
    corner_radius: 0
    padding: [6, 4, 6, 0]

  Tab:
    fill: "#1E2026"
    border_color: "#00000000"
    border_thickness: 1.0
    corner_radius: [3, 3, 0, 0]
    padding: [12, 5]
    text_color: "$TextMuted"
    font_size: 18

  "Tab:hover":
    fill: "$Surface2"
    text_color: "$Text"

  "Tab.active":
    fill: "#2A4975"
    border_color: "$Accent"
    text_color: "#FFFFFF"

  MenuBar:
    fill: "#181A20"
    border_color: "$Border"
    border_thickness: 1.0
    corner_radius: 0
    padding: [6, 2]

  MenuTrigger:
    fill: "#00000000"
    border_thickness: 0
    corner_radius: 2
    padding: [10, 4]
    text_color: "$Text"
    font_size: 18

  "MenuTrigger:hover":
    fill: "$Surface2"
    text_color: "#FFFFFF"

  MenuPopup:
    fill: "#22242BFC"
    border_color: "#4D5364"
    border_thickness: 1.0
    shadow_color: "#0000008C"
    shadow_offset: [0, 6]
    shadow_blur: 14
    corner_radius: 3
    padding: 4

  MenuItem:
    fill: "#00000000"
    border_thickness: 0
    corner_radius: 2
    padding: [10, 5]
    text_color: "$Text"
    font_size: 18

  "MenuItem:hover":
    fill: "$Accent"
    text_color: "#FFFFFF"

  "MenuItem:disabled":
    text_color: "$TextMuted"

  TemplateCard:
    fill: "$Surface1"
    border_color: "$Border"
    border_thickness: 1.5
    corner_radius: 6
    padding: 8
    text_color: "$Text"
    font_size: 18
    transition_ms: 80

  "TemplateCard:hover":
    fill: "$Surface2"
    border_color: "$Accent"

  "TemplateCard.selected":
    fill: "#1F2E47"
    border_color: "$AccentHover"
    border_thickness: 2.0

  "TemplateCard.selected:hover":
    fill: "#243654"
    border_color: "$AccentHover"

  Separator:
    fill: "$Border"
    corner_radius: 0

  ViewportSlot:
    fill: "#0E1117"
    border_color: "$Border"
    border_thickness: 1.0
    corner_radius: 6

  NodeGraph:
    fill: "#0D1016"
    border_color: "$Border"
    border_thickness: 1.0

  TitleClose:
    fill: "#00000000"
    border_thickness: 0
    corner_radius: 0
    padding: 0
    text_color: "$TextMuted"
    font_size: 16
    transition_ms: 50

  "TitleClose:hover":
    fill: "$Danger"
    text_color: "#FFFFFF"

  "TitleClose:pressed":
    fill: "#AE3840"
    text_color: "#FFFFFF"
    corner_radius: 6
    text_color: "$Text"
